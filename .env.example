# Copy this file to .env (/setup does it for you). .env is private and never committed.

# Any long random string. /setup generates one.
SECRET_KEY=change-me

DEBUG=True

# OPTIONAL. Only the in-app "Tailor CV" button uses this (pay-per-use API key from
# console.anthropic.com). You do NOT need it: Claude Code tailors CVs for free with
# your Claude plan. Just say "tailor my CV for lead 4".
ANTHROPIC_API_KEY=

# Optional: which Claude model the in-app button uses.
# CLAUDE_MODEL=claude-opus-5-5

# Optional: your timezone (default Europe/Dublin).
# TIME_ZONE=Europe/Dublin
